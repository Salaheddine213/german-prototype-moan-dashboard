# German Electricity Market Analytics backend configuration.
# Copy to .env (git-ignored) and adjust paths. All settings use the
# MARKET_ prefix and map to fields in app/config.py.
#
# DEFAULT (empty .env): runs in DEMO mode with clearly-labelled synthetic
# German market data generated in-memory at startup. Nothing else required.

# -- Live mode (optional) ---------------------------------------------------
# Show current backend state via /api/health (data_mode: "demo" | "live").
#
# Uncomment to switch to LIVE mode and point at your own on-disk DuckDB
# holding ts_15min / ts_hourly / ts_4hourly / ts_daily / provenance.
# MARKET_DUCKDB_PATH=/path/to/market.duckdb

# Directory containing Production_Ensemble_* and Forecast_* run directories.
# In demo mode this receives the generated Demo artifacts (sub-dir "demo").
MARKET_MODEL_RESULTS_DIR=demo_artifacts

# Glob for the engineered-features file (.feather or .parquet) used by
# /api/ml/correlation-matrix.
MARKET_HISTORICAL_FEATURES_PATH=demo_artifacts/demo/Historical_data_features_engineered_*.parquet

# Optional sidecar CSVs (globs) for the commodities page. When absent, the
# EUR/USD and Coal API2 series and KPIs degrade to empty arrays.
MARKET_EUR_USD_PATH=/path/to/EUR_USD_daily_*.csv
MARKET_COAL_API2_PATH=/path/to/commodity_coal_API2_daily_*.csv

# CORS origins for the frontend dev server (JSON list).
MARKET_CORS_ORIGINS=["http://localhost:5173"]